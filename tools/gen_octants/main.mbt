///|
const OctantMin : Int = 0x1CD00

///|
const OctantMax : Int = 0x1CDE5

///|
const OctantsLen : Int = OctantMax - OctantMin + 1

///|
const GeneratedLineLimit : Int = 82

///|
priv suberror OctantsParseError {
  InvalidOctantDigit(Char)
  InvalidOctantLine(String)
  InvalidOctantCount(expected~ : Int, actual~ : Int)
} derive(Debug)

///|
fn font_path(file : String) -> String {
  let font_dir = @path.Path::join("..", "font")
  font_dir.join(file).normalize().to_string()
}

///|
fn parse_octant_digit(digit : Char) -> Int raise OctantsParseError {
  match digit {
    '1' => 1 << 0
    '2' => 1 << 1
    '3' => 1 << 2
    '4' => 1 << 3
    '5' => 1 << 4
    '6' => 1 << 5
    '7' => 1 << 6
    '8' => 1 << 7
    _ => raise InvalidOctantDigit(digit)
  }
}

///|
fn parse_octant_line(line : StringView) -> Int? raise OctantsParseError {
  if line.length() == 0 || line.strip_prefix("#") is Some(_) {
    return None
  }
  guard line.split_once("-") is Some((_, digits)) else {
    raise InvalidOctantLine(line.to_owned())
  }
  let mut mask = 0
  for digit in digits {
    mask = mask | parse_octant_digit(digit)
  }
  Some(mask)
}

///|
fn parse_octants(source : String) -> Array[Int] raise OctantsParseError {
  let octants : Array[Int] = []
  for raw_line in source.split("\n") {
    let line = raw_line.trim_end(chars="\r")
    match parse_octant_line(line) {
      Some(mask) => octants.push(mask)
      None => ()
    }
  }
  guard octants.length() == OctantsLen else {
    raise InvalidOctantCount(expected=OctantsLen, actual=octants.length())
  }
  octants
}

///|
fn emit_octants_table(octants : Array[Int]) -> String {
  let out = StringBuilder(size_hint=4096)
  out.write_string("///|\n")
  out.write_string(
    "// Generated by tools/gen_octants from font/octants.txt. Do not edit by hand.\n",
  )
  out.write_string("let legacy_computing_octants : ReadOnlyArray[Int] = [\n")
  if octants.length() > 0 {
    let mut line_len = 2
    out.write_string("  ")
    for mask in octants {
      let token = "\{mask},"
      let token_len = token.length()
      if line_len + 1 + token_len > GeneratedLineLimit {
        out.write_string("\n  ")
        out.write_string(token)
        line_len = 2 + token_len
      } else {
        if line_len > 2 {
          out.write_string(" ")
          line_len += 1
        }
        out.write_string(token)
        line_len += token_len
      }
    }
    out.write_string("\n")
  }
  out.write_string("]\n")
  out.to_string()
}

///|
async fn main {
  let source_path = font_path("octants.txt")
  let output_path = font_path("sprite_draw_legacy_computing_octants_data.mbt")
  let source = @fs.read_file(source_path).text()
  let octants = parse_octants(source)
  @fs.write_file(
    output_path,
    emit_octants_table(octants),
    create_mode=CreateOrTruncate,
  )
}
