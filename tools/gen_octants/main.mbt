///|
const OctantMin : Int = 0x1CD00

///|
const OctantMax : Int = 0x1CDE5

///|
const OctantsLen : Int = OctantMax - OctantMin + 1

///|
fn font_path(file : String) -> String {
  let font_dir = @path.Path::join("..", "font")
  font_dir.join(file).normalize().to_string()
}

///|
fn parse_octant_digit(digit : Char) -> Int {
  match digit {
    '1' => 1 << 0
    '2' => 1 << 1
    '3' => 1 << 2
    '4' => 1 << 3
    '5' => 1 << 4
    '6' => 1 << 5
    '7' => 1 << 6
    '8' => 1 << 7
    _ => abort("invalid octant digit: \{digit}")
  }
}

///|
fn parse_octant_line(line : StringView) -> Int? {
  if line.length() == 0 || line.strip_prefix("#") is Some(_) {
    return None
  }
  guard line.split_once("-") is Some((_, digits)) else {
    abort("invalid octant line: \{line}")
  }
  let mut mask = 0
  for digit in digits {
    mask = mask | parse_octant_digit(digit)
  }
  Some(mask)
}

///|
fn parse_octants(source : String) -> Array[Int] {
  let octants : Array[Int] = []
  for raw_line in source.split("\n") {
    let line = raw_line.trim_end(chars="\r")
    match parse_octant_line(line) {
      Some(mask) => octants.push(mask)
      None => ()
    }
  }
  guard octants.length() == OctantsLen else {
    abort(
      "expected \{OctantsLen} octants from U+\{OctantMin.to_string(radix=16)}..U+\{OctantMax.to_string(radix=16)}, got \{octants.length()}",
    )
  }
  octants
}

///|
fn write_table_entry(out : StringBuilder, mask : Int, index : Int) -> Unit {
  if index % 16 == 0 {
    out.write_string("  ")
  }
  out.write_string(mask.to_string())
}

///|
fn emit_octants_table(octants : Array[Int]) -> String {
  let out = StringBuilder(size_hint=4096)
  out.write_string("///|\n")
  out.write_string(
    "// Generated by tools/gen_octants from font/octants.txt. Do not edit by hand.\n",
  )
  out.write_string("let legacy_computing_octants : FixedArray[Int] = [\n")
  for index in 0..<octants.length() {
    write_table_entry(out, octants[index], index)
    if index + 1 < octants.length() {
      out.write_string(",")
    }
    if index % 16 == 15 || index + 1 == octants.length() {
      out.write_string("\n")
    } else {
      out.write_string(" ")
    }
  }
  out.write_string("]\n")
  out.to_string()
}

///|
async fn main {
  let source_path = font_path("octants.txt")
  let output_path = font_path("sprite_draw_legacy_computing_octants_data.mbt")
  let source = @fs.read_file(source_path).text()
  let octants = parse_octants(source)
  @fs.write_file(
    output_path,
    emit_octants_table(octants),
    create_mode=CreateOrTruncate,
  )
}
